# =============================================================================
# Variáveis de ambiente — Assistente Médico (LangGraph + PostgreSQL + pgvector)
# =============================================================================
# Copie para .env e ajuste os valores. O arquivo .env NÃO é versionado.
#   cp .env.sample .env
#
# O carregamento via python-dotenv é feito por src/services/llm_provider_service.py;
# para os demais módulos (src/db), exporte as variáveis no shell ou use uma
# ferramenta de carregamento de .env (ex.: direnv, export $(cat .env | xargs)).

# --- Banco de dados (PostgreSQL 17 + pgvector via Docker) ---------------------
# Usado por src/db/connection.py e pelos scripts database/etl_seed.py e
# database/embeddings_ingest.py (flag --dsn sobrescreve).
# Deve espelhar os valores do docker-compose.yml (ver final deste arquivo).
MEDPT_PG_DSN=postgresql://medico:medico_dev@localhost:5433/assistente_medico

# --- Testes de integração -----------------------------------------------------
# "1" executa os testes marcados com 'pg' (exigem o container PostgreSQL no ar).
# Ausente ou com qualquer outro valor, esses testes são pulados.
MEDPT_TESTAR_PG=0

# --- LLM (LangGraph) ----------------------------------------------------------
# O provedor é escolhido automaticamente por src/services/llm_provider_service.py:
#   1. GROQ_API_KEY presente  -> Groq (padrão, com reasoning_effort="none")
#   2. somente OPENAI_API_KEY -> OpenAI (gpt-4o-mini, sem reasoning_effort)
# Ao menos UMA das duas chaves é necessária para a aplicação rodar.
GROQ_API_KEY=
OPENAI_API_KEY=
# Overrides opcionais (permitem apontar para qualquer provedor de API no formato
# OpenAI, ex.: Ollama, vLLM, LiteLLM):
#   MEDPT_LLM_BASE_URL=
#   MEDPT_LLM_MODEL=
#   MEDPT_LLM_REASONING_EFFORT=

# --- Embeddings (vector store) ------------------------------------------------
# Provedor padrão usado por obter_vectorstore() quando nenhum é informado.
# Opções: "mock" (padrão) ou "openai".
#   - mock: DeterministicFakeEmbedding do langchain-core (determinístico pelo
#     texto, sem chave de API, ideal p/ testes e desenvolvimento).
#   - openai: exige OPENAI_API_KEY válida (modelo text-embedding-3-small).
MEDPT_EMBEDDING_PROVIDER=mock

# --- Conhecimento documental (RAG) -------------------------------------------
# Diretório com os documentos de referência (PDFs, Excel) que alimentam a
# coleção de conhecimento contextual. Estrutura sugerida:
#   knowledge/pdf/    (protocolos, artigos, diretrizes em PDF)
#   knowledge/excel/  (planilhas de referência)
# Usado por database/conhecimento/ingestao_conhecimento.py (padrão em branco
# = apenas os documentos de exemplo embutidos).
MEDPT_KNOWLEDGE_DIR=
