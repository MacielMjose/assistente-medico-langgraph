# =============================================================================
# Variáveis de ambiente — Assistente Médico (LangGraph + PostgreSQL + pgvector)
# =============================================================================
# Copie para .env e ajuste os valores. O arquivo .env NÃO é versionado.
#   cp .env.sample .env

# --- Banco de dados (PostgreSQL 17 + pgvector via Docker) ---------------------
# DSN de conexão ao banco de dados PostgreSQL
MEDPT_PG_DSN=postgresql://medico:medico_dev@localhost:5433/assistente_medico

# --- Testes de integração -----------------------------------------------------
# "1" executa os testes marcados com 'pg' (exigem o container PostgreSQL no ar).
MEDPT_TESTAR_PG=0

# --- LLM via Ollama (modelo customizado local) --------------------------------
# URL do servidor Ollama (padrão: http://localhost:11434)
MEDPT_OLLAMA_BASE_URL=http://localhost:11434

# Nome do modelo Ollama para chat (OBRIGATÓRIO)
# Exemplo: assistente_medico_small
MEDPT_OLLAMA_CHAT_MODEL=assistente_medico_small

# --- Embeddings (vector store) ------------------------------------------------
# Provedor de embeddings: "mock" (padrão p/ testes) ou "ollama" (produção)
# Se usar "ollama", configure MEDPT_OLLAMA_EMBEDDING_MODEL abaixo
MEDPT_EMBEDDING_PROVIDER=ollama

# Nome do modelo Ollama para embeddings (necessário se MEDPT_EMBEDDING_PROVIDER=ollama)
# Exemplo: bge-m3
MEDPT_OLLAMA_EMBEDDING_MODEL=bge-m3

# --- Conhecimento documental (RAG) -------------------------------------------
# Diretório com documentos de referência (PDFs, Excel) para a base de conhecimento
# Estrutura sugerida:
#   knowledge/pdf/    (protocolos, artigos, diretrizes)
#   knowledge/excel/  (planilhas de referência)
MEDPT_KNOWLEDGE_DIR=
