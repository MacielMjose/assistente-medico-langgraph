# =============================================================================
# Variáveis de ambiente — Assistente Médico (LangGraph + PostgreSQL + pgvector)
# =============================================================================
# Copie para .env e ajuste os valores. O arquivo .env NÃO é versionado.
#   cp .env.sample .env
#
# O carregamento via python-dotenv é feito por src/services/llm_provider_service.py;
# para os demais módulos (src/db), exporte as variáveis no shell ou use uma
# ferramenta de carregamento de .env (ex.: direnv, export $(cat .env | xargs)).

# --- Banco de dados (PostgreSQL 17 + pgvector via Docker) ---------------------
# Usado por src/db/connection.py e pelos scripts database/etl_seed.py e
# database/embeddings_ingest.py (flag --dsn sobrescreve).
# Deve espelhar os valores do docker-compose.yml (ver final deste arquivo).
MEDPT_PG_DSN=postgresql://medico:medico_dev@localhost:5433/assistente_medico

# --- Testes de integração -----------------------------------------------------
# "1" executa os testes marcados com 'pg' (exigem o container PostgreSQL no ar).
# Ausente ou com qualquer outro valor, esses testes são pulados.
MEDPT_TESTAR_PG=0

# --- LLM (LangGraph) ----------------------------------------------------------
# O provedor é escolhido automaticamente por src/services/llm_provider_service.py:
#   1. MEDPT_BEDROCK_MODEL_ID (+ credenciais AWS)  -> AWS Bedrock
#   2. GROQ_API_KEY presente  -> Groq (padrão, com reasoning_effort="none")
#   3. somente OPENAI_API_KEY -> OpenAI (gpt-4o-mini, sem reasoning_effort)
#   4. nenhuma chave de nuvem, apenas MEDPT_OLLAMA_CHAT_MODEL -> Ollama local
#
# MEDPT_LLM_PROVIDER força a escolha (útil se você quer testar um provedor
# específico sem alterar as variáveis existentes): "bedrock" | "groq" | "openai" | "ollama".
GROQ_API_KEY=
OPENAI_API_KEY=
MEDPT_LLM_PROVIDER=
# Overrides opcionais para Groq/OpenAI (qualquer provedor de API no formato
# OpenAI, ex.: vLLM, LiteLLM — para Ollama use as variáveis MEDPT_OLLAMA_* abaixo):
#   MEDPT_LLM_BASE_URL=
#   MEDPT_LLM_MODEL=
#   MEDPT_LLM_REASONING_EFFORT=

# --- AWS Bedrock (modelo customizado na nuvem) --------------------------------
# Usa credenciais AWS do sistema (boto3). Configure:
#   - AWS_ACCESS_KEY_ID
#   - AWS_SECRET_ACCESS_KEY
#   - AWS_PROFILE (opcional, usa padrão se não definido)
#   - AWS_REGION (padrão: us-east-1)
#
# MEDPT_BEDROCK_MODEL_ID: ARN completo do modelo customizado no AWS Bedrock
#   Use o ARN que você vê na console AWS Bedrock → Custom Models → seu modelo
#   Formato: arn:aws:bedrock:REGIÃO:ACCOUNT_ID:imported-model/MODEL_ID
#   Exemplo: arn:aws:bedrock:us-east-1:651557246751:imported-model/5bsz71f67w1p
#
# MEDPT_BEDROCK_MODEL_PROVIDER: informativo (compatibilidade futura)
#   Exemplos: "qwen", "anthropic", "mistral", "meta", "cohere", "ai21"
#
# Credenciais AWS: Configure uma das formas abaixo
#   1. ~/.aws/credentials (recomendado para desenvolvimento)
#   2. AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY
#   3. AWS_PROFILE + credenciais em ~/.aws/credentials
#
# Quando definido, Bedrock tem precedência sobre Groq/OpenAI (a menos que
# MEDPT_LLM_PROVIDER força explicitamente outro provedor).
MEDPT_BEDROCK_MODEL_ID=arn:aws:bedrock:us-east-1:651557246751:imported-model/5bsz71f67w1p
MEDPT_BEDROCK_MODEL_PROVIDER=qwen
AWS_REGION=us-east-1
# AWS_PROFILE=seu-perfil  # Opcional se tiver múltiplos perfis AWS

# --- Ollama (modelo customizado local) ----------------------------------------
# Sobe junto com o Postgres via `docker compose up -d` (serviço "ollama" no
# docker-compose.yml), expondo a API nativa em MEDPT_OLLAMA_BASE_URL.
# Depois de subir o container, importe seu modelo fine-tuned (ex.: GGUF) com:
#   docker compose exec ollama ollama create meu-modelo-medico -f /caminho/Modelfile
# e aponte MEDPT_OLLAMA_CHAT_MODEL para o nome usado no "ollama create".
MEDPT_OLLAMA_BASE_URL=http://localhost:11434
MEDPT_OLLAMA_CHAT_MODEL=
# Só necessário se MEDPT_EMBEDDING_PROVIDER=ollama (ver seção Embeddings abaixo):
MEDPT_OLLAMA_EMBEDDING_MODEL=

# --- Embeddings (vector store) ------------------------------------------------
# Provedor padrão usado por obter_vectorstore() quando nenhum é informado.
# Opções: "mock" (padrão), "openai" ou "ollama".
#   - mock: DeterministicFakeEmbedding do langchain-core (determinístico pelo
#     texto, sem chave de API, ideal p/ testes e desenvolvimento).
#   - openai: exige OPENAI_API_KEY válida (modelo text-embedding-3-small).
#   - ollama: exige MEDPT_OLLAMA_EMBEDDING_MODEL e o Ollama no ar (ver acima).
MEDPT_EMBEDDING_PROVIDER=mock

# --- Conhecimento documental (RAG) -------------------------------------------
# Diretório com os documentos de referência (PDFs, Excel) que alimentam a
# coleção de conhecimento contextual. Estrutura sugerida:
#   knowledge/pdf/    (protocolos, artigos, diretrizes em PDF)
#   knowledge/excel/  (planilhas de referência)
# Usado por database/conhecimento/ingestao_conhecimento.py (padrão em branco
# = apenas os documentos de exemplo embutidos).
MEDPT_KNOWLEDGE_DIR=
